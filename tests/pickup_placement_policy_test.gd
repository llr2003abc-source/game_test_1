extends "res://tests/inventory_grid_test.gd"
func fixture() -> PlayerInventoryComponent:
	var inv:=PlayerInventoryComponent.new()
	inv.transactions.equip(InventoryItemFactory.create(load("res://data/items/rig_1.tres")),4)
	inv.transactions.equip(InventoryItemFactory.create(load("res://data/items/backpack_1.tres")),5)
	return inv
func _run() -> void:
	check(FileAccess.file_exists("res://scripts/inventory/pickup_placement_policy.gd"),"independent placement policy exists")
	if failures==0:
		var policy: Variant=load("res://scripts/inventory/pickup_placement_policy.gd")
		var inv:=fixture()
		var mag: InventoryItemInstance=InventoryItemFactory.create(load("res://data/items/magazine_1_item.tres"),1,17)
		check(policy.find_destination(inv,mag).grid==inv.get_equipped_rig().grids[0],"magazine prefers equipped rig")
		for grid in inv.get_equipped_rig().grids: grid.place_item(item(1,2),Vector2i.ZERO)
		check(policy.find_destination(inv,mag).grid==inv.get_equipped_backpack().grid,"full rig falls back to backpack")
		var bag: InventoryGrid=inv.get_equipped_backpack().grid
		bag.place_item(item(5,5),Vector2i.ZERO)
		check(policy.find_destination(inv,mag).is_empty(),"magazine with no space never uses Secure")
		var ammo: InventoryItemInstance=InventoryItemFactory.create(load("res://data/items/weapon1_level2_ammo_item.tres"),60)
		check(policy.find_destination(inv,ammo).grid==inv.pockets[0],"ammo after full backpack prefers pocket")
		for grid in inv.pockets: grid.place_item(item(1,1),Vector2i.ZERO)
		check(policy.find_destination(inv,ammo).is_empty() and inv.secure.grid.placements.is_empty(),"ammo never auto-uses empty Secure")
		var gun: InventoryItemInstance=InventoryItemFactory.create(load("res://data/items/primary_weapon_1_item.tres"),1,17)
		check(policy.find_destination(inv,gun).slot==0,"empty compatible primary preferred")
		inv.transactions.equip(gun,0)
		var second: InventoryItemInstance=InventoryItemFactory.create(gun.definition,1,17)
		check(policy.find_destination(inv,second).is_empty(),"occupied primary/full bag fails without switching")
		bag.remove_item(bag.placements[0].item)
		check(policy.find_destination(inv,second).grid==bag,"occupied primary falls back to backpack")
		check(inv.equipment.get_active_item()==gun,"destination search never switches active weapon")
		var generic: InventoryItemInstance=item(1,1)
		check(policy.find_destination(inv,generic).grid==bag,"generic prefers backpack")
		var bag_item: InventoryItemInstance=InventoryItemFactory.create(load("res://data/items/backpack_1.tres"))
		var rig_item: InventoryItemInstance=InventoryItemFactory.create(load("res://data/items/rig_1.tres"))
		check(policy.find_destination(inv,bag_item).is_empty(),"occupied Backpack slot rejects container nesting")
		check(policy.find_destination(inv,rig_item).is_empty(),"occupied Rig slot rejects container nesting")
		var empty:=PlayerInventoryComponent.new()
		check(policy.find_destination(empty,bag_item).slot==5,"empty Backpack slot equips")
		check(policy.find_destination(empty,rig_item).slot==4,"empty Rig slot equips")
		for category in [ItemDefinition.Category.SECONDARY_WEAPON,ItemDefinition.Category.PISTOL,ItemDefinition.Category.MELEE]:
			var definition: ItemDefinition=gun.definition.duplicate()
			definition.category=category
			definition.allowed_equipment_slots.assign([category-3])
			var weapon: InventoryItemInstance=InventoryItemFactory.create(definition)
			check(policy.find_destination(empty,weapon).slot==category-3,"generic compatible weapon slot policy")
		var world:=Node3D.new()
		root.add_child(world)
		var node: DroppedItem=WorldItemFactory.spawn(second,inv.transactions,world,Transform3D.IDENTITY)
		check(inv.transactions.pickup_world_item(node).success and bag.get_placement(second)!=null,"pickup calls policy independently of world/interactor/UI")
		check(inv.equipment.get_active_item()==gun,"backpack pickup leaves active weapon unchanged")
		world.queue_free()
		await process_frame
		inv.free()
		empty.free()
	print("PICKUP_PLACEMENT_POLICY_RESULT assertions=%d failures=%d"%[assertions,failures])
	quit(1 if failures else 0)
