extends "res://tests/inventory_grid_test.gd"
func _run() -> void:
	var ammo := AmmoData.new()
	check("ammo_type_id" in ammo,"ammo stable type ID exists")
	check("magazine_type_id" in MagazineData.new(),"magazine stable type ID exists")
	check("compatible_magazine_type_ids" in WeaponData.new(),"weapon compatibility IDs exist")
	if failures==0:
		var s: Variant=load("res://scripts/inventory/inventory_transaction_service.gd").new()
		check(s.has_method("load_ammo_into_magazine"),"transaction supports loading actual rounds")
		if failures==0:
			var g: Variant=load("res://scripts/inventory/inventory_grid.gd").new(5,5)
			s.register_grid(g)
			var loose: Variant=load("res://scripts/inventory/inventory_item_instance.gd").new(load("res://data/items/weapon1_level2_ammo_item.tres"),60)
			var d: Variant=load("res://data/items/magazine_1_item.tres")
			var mag:=MagazineInstance.new()
			mag.initialize_full(d.magazine_data)
			for i in range(13): mag.pop_round()
			var wrapper: Variant=load("res://scripts/inventory/inventory_item_instance.gd").new(d,1,mag)
			g.place_item(loose,Vector2i.ZERO)
			g.place_item(wrapper,Vector2i(1,0))
			check(s.load_ammo_into_magazine(loose,wrapper,30)==13,"partial load fills only available space")
			check(loose.stack_count==47 and mag.get_round_count()==30,"ammo conservation after partial load")
			check(mag.rounds[-1]==loose.definition.ammo_data and mag.rounds[0]==d.magazine_data.default_ammo,"mixed ammo appended in correct order")
			mag.clear()
			var bad: Variant=loose.definition.duplicate()
			bad.ammo_data=bad.ammo_data.duplicate()
			bad.ammo_data.ammo_type_id=&"wrong"
			var wrong: Variant=load("res://scripts/inventory/inventory_item_instance.gd").new(bad,60)
			g.place_item(wrong,Vector2i(3,0))
			check(s.load_ammo_into_magazine(wrong,wrapper,30)==0 and wrong.stack_count==60 and mag.is_empty(),"wrong ammo makes no mutation")
			check(s.load_ammo_into_magazine(loose,wrapper,30)==30 and loose.stack_count==17,"load 30 actual rounds")
			check(s.load_ammo_into_magazine(loose,wrapper,1)==0,"full mag no consumption")
			var target: Variant=load("res://scripts/inventory/inventory_item_instance.gd").new(loose.definition,40)
			g.place_item(target,Vector2i(4,0))
			check(s.merge_stacks(loose,target)==17 and target.stack_count==57,"stack quantities conserved")
			var split: Variant=s.split_stack(target,20)
			check(split!=null and split.stack_count==20 and target.stack_count==37,"split produces 37 plus20")
			for count in [0,-1,37,38]: check(s.split_stack(target,count)==null and target.stack_count==37,"invalid split atomic")
			check(loose.definition.ammo_data.bullet_level==2,"new loose ammo really level2")
	print("AMMO_MAGAZINE_COMPATIBILITY_RESULT assertions=%d failures=%d"%[assertions,failures])
	quit(1 if failures else 0)
