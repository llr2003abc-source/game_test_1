extends "res://tests/inventory_grid_test.gd"
func _run() -> void:
	check(FileAccess.file_exists("res://scripts/weapons/reload_input_resolver.gd"),"R resolver exists")
	if failures==0:
		var resolver: Variant=load("res://scripts/weapons/reload_input_resolver.gd").new()
		var requests: Array=[]
		resolver.reload_requested.connect(func(type: int) -> void: requests.append(type))
		resolver.press()
		check(requests.is_empty(),"first R never immediately tactical")
		resolver.tick(0.15)
		resolver.press()
		check(requests==[2],"double R is exactly one drop")
		resolver.tick(1.0)
		check(requests==[2],"double never later sends tactical")
		requests.clear()
		resolver.press()
		resolver.tick(0.22)
		check(requests==[1],"single R confirmed after0.22")
		resolver.press()
		resolver.tick(0.23)
		check(requests==[1,1],"expired second R begins separate single")
		requests.clear()
		resolver.press()
		for i in range(5): resolver.press(true)
		resolver.tick(0.22)
		check(requests==[1],"key echo cannot create double")
		requests.clear()
		resolver.press()
		resolver.set_enabled(false)
		resolver.tick(1.0)
		resolver.set_enabled(true)
		resolver.tick(1.0)
		check(requests.is_empty(),"UI disables/cancels pending single permanently")
		for hz in [30,60,120]:
			resolver.press()
			for i in range(hz): resolver.tick(1.0/hz)
			check(requests.size()==1 and requests[0]==1,"single independent of Hz")
			requests.clear()
		resolver.free()
	print("RELOAD_INPUT_RESOLVER_RESULT assertions=%d failures=%d"%[assertions,failures])
	quit(1 if failures else 0)
