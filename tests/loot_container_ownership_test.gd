extends "res://tests/inventory_grid_test.gd"

func _run() -> void:
	check(FileAccess.file_exists("res://scripts/inventory/loot_container_runtime.gd"),"external ownership runtime exists")
	if failures==0:
		var script: Script=load("res://scripts/inventory/loot_container_runtime.gd")
		var a: Variant=script.new(&"a")
		var b: Variant=script.new(&"b")
		var definition: ItemDefinition=load("res://data/items/magazine_1_item.tres")
		var original:=InventoryItemFactory.create(definition,1,17)
		a.inventory_grid.place_item(original,Vector2i.ZERO)
		check(a.transactions.register_external_container(a),"crateA registration succeeds before UI opens")
		b.inventory_grid.place_item(original,Vector2i.ZERO)
		check(not b.transactions.register_external_container(b),"two crates cannot own same ItemInstance")
		check(b.transactions.items.is_empty() and b.inventory_grid.get_transactions()==null,"foreign Item registration rejects entire crate")
		var alias:=InventoryItemInstance.new(definition,1,original.runtime_state)
		b.inventory_grid.remove_item(original)
		b.inventory_grid.place_item(alias,Vector2i.ZERO)
		check(not b.transactions.register_external_container(b),"two registries reject duplicate MagazineInstance wrapper")
		check(alias.get_owner_registry()==null and a.transactions.find_runtime_item(original.runtime_state)==original,"duplicate wrapper failure preserves original runtime registry")
		for invalid in ["duplicate_item","duplicate_runtime","outside","overlap","nested"]:
			var crate: Variant=script.new(StringName(invalid))
			var good:=InventoryItemFactory.create(definition,1,30)
			crate.inventory_grid.place_item(good,Vector2i.ZERO)
			match invalid:
				"duplicate_item": crate.inventory_grid.placements.append(InventoryPlacement.new(good,Vector2i(2,0)))
				"duplicate_runtime": crate.inventory_grid.place_item(InventoryItemInstance.new(definition,1,good.runtime_state),Vector2i(2,0))
				"outside": crate.inventory_grid.placements[0].position=Vector2i(8,0)
				"overlap": crate.inventory_grid.placements.append(InventoryPlacement.new(InventoryItemFactory.create(definition),Vector2i.ZERO))
				"nested":
					var rig:=InventoryItemFactory.create(load("res://data/items/rig_1.tres"))
					rig.runtime_state.grids[0].placements.append(InventoryPlacement.new(InventoryItemFactory.create(definition),Vector2i(1,0)))
					crate.inventory_grid.place_item(rig,Vector2i(3,0))
			check(not crate.transactions.register_external_container(crate),"invalid complete registration rejected: "+invalid)
			check(crate.transactions.items.is_empty() and crate.transactions.grids.is_empty() and good.get_owner_registry()==null,"failed external registration atomic: "+invalid)
		var c: Variant=script.new(&"c")
		var independent:=InventoryItemFactory.create(definition,1,30)
		c.inventory_grid.place_item(independent,Vector2i(4,3))
		check(c.transactions.register_external_container(c),"independent crateC accepts its own contents")
		check(a.transactions!=c.transactions and a.inventory_grid!=c.inventory_grid and original.runtime_state!=independent.runtime_state,"registries/grids/runtime instances independent")
		original.runtime_state.pop_round()
		check(original.runtime_state.get_round_count()==16 and independent.runtime_state.get_round_count()==30,"crateA mutation does not affect crateC")
	print("LOOT_CONTAINER_OWNERSHIP_RESULT assertions=%d failures=%d"%[assertions,failures])
	quit(1 if failures else 0)
