extends "res://tests/inventory_grid_test.gd"

class CountingGrid extends InventoryGrid:
	var checks: int = 0
	func can_place(value: InventoryItemInstance, cell: Vector2i, rotation: bool = false) -> bool:
		checks += 1
		return super.can_place(value,cell,rotation)

func _run() -> void:
	for script_path in ["inventory_drag_context","inventory_drag_candidate_resolver"]:
		check(FileAccess.file_exists("res://scripts/ui/%s.gd"%script_path),"required drag helper: "+script_path)
	if failures==0:
		var context_script: Variant=load("res://scripts/ui/inventory_drag_context.gd")
		var resolver: Variant=load("res://scripts/ui/inventory_drag_candidate_resolver.gd")
		var service:=InventoryTransactionService.new()
		var source:=InventoryGrid.new(5,5)
		var target:=InventoryGrid.new(1,2,&"rig")
		service.register_grid(source)
		service.register_grid(target)
		var mag: InventoryItemInstance=item(1,2)
		source.place_item(mag,Vector2i(1,1))
		var origin:=Vector2(300,200)
		for grab in [Vector2(24,12),Vector2(24,48),Vector2(24,75)]:
			var context: Variant=context_script.new(mag,48.0,grab,source,Vector2i(1,1))
			check(context.item==mag and context.source_container==source and context.source_placement==Vector2i(1,1),"context holds original item and source")
			check(context.grab_offset_pixels==grab and context.get_ghost_top_left(origin+grab)==origin,"ghost preserves exact top/middle/bottom grab")
			check(context.get_ghost_top_left(origin+grab+Vector2(40,-13))==origin+Vector2(40,-13),"mouse displacement does not change grab")
			var candidate: Dictionary=resolver.resolve_grid(context,target,origin+grab,origin)
			check(candidate.valid and candidate.position==Vector2i.ZERO and not candidate.snapped,"any grab resolves same aligned rig placement")
			check(service.get_location(mag).grid==source and not mag.rotated,"preview never moves real item")
			check(service.move(mag,target,candidate.position,candidate.rotated),"candidate commits through original transaction")
			check(target.get_placement(mag).position==candidate.position,"what you see equals committed cell")
			service.move(mag,source,Vector2i(1,1))
		var context: Variant=context_script.new(mag,48.0,Vector2(24,75))
		context.rotate_preview()
		check(context.preview_rotation and context.get_preview_size()==Vector2i(2,1),"rotation changes preview size only")
		check(context.grab_offset_pixels.is_equal_approx(Vector2(48,37.5)) and not mag.rotated,"normalized lower grab maps naturally on rotation")
		check(not resolver.resolve_grid(context,target,origin+context.grab_offset_pixels,origin).valid,"rotated2x1 cannot snap into1x2 rig")
		for i in range(9): context.rotate_preview()
		check(not context.preview_rotation and context.grab_offset_pixels==Vector2(24,75),"repeated rotation has no anchor drift")
		for distance in [8.0,16.0,17.0,48.0]:
			var candidate: Dictionary=resolver.resolve_grid(context,target,origin+context.grab_offset_pixels-Vector2(distance,0),origin)
			check(candidate.raw_position==Vector2i(-1,0),"negative coordinates use floor")
			check(candidate.valid==(distance<=16.0),"inclusive16px snap boundary: "+str(distance))
			check(candidate.snapped==(distance<=16.0),"only near invalid raw snaps")
			if candidate.valid: check(is_equal_approx(candidate.snap_distance,distance) and candidate.position==Vector2i.ZERO,"snap records pixel distance and exact candidate")
		var candidate: Dictionary=resolver.resolve_grid(context,target,origin+context.grab_offset_pixels+Vector2(17,0),origin)
		check(candidate.valid and not candidate.snapped and candidate.raw_position==Vector2i.ZERO,"legal raw wins even when not aligned to cell edge")
		check(not resolver.resolve_grid(context,target,origin+context.grab_offset_pixels+Vector2(49,0),origin).valid,"large out of bounds has no magnetic snap")
		var blocked: InventoryItemInstance=item(1,2)
		target.place_item(blocked,Vector2i.ZERO)
		check(not resolver.resolve_grid(context,target,origin+context.grab_offset_pixels,origin).valid,"occupancy is never bypassed")
		target.remove_item(blocked)
		check(not resolver.resolve_grid(context,target,origin+context.grab_offset_pixels,origin,48.0,16.0,true).valid,"reload lock rejects UI candidate")
		var large: Variant=context_script.new(item(2,2),48.0,Vector2(24,24))
		check(not resolver.resolve_grid(large,target,origin+large.grab_offset_pixels,origin).valid,"2x2 never spans rig slots")
		var small:=InventoryGrid.new(3,3)
		small.place_item(item(1,1),Vector2i.ZERO)
		var tiny: Variant=context_script.new(item(1,1),20.0,Vector2.ZERO)
		candidate=resolver.resolve_grid(tiny,small,Vector2(11,9),Vector2.ZERO,20.0)
		check(candidate.valid and candidate.position==Vector2i(1,0),"scaled-grid nearest legal candidate wins")
		for i in range(12):
			candidate=resolver.resolve_grid(tiny,small,Vector2(10,10),Vector2.ZERO,20.0)
			check(candidate.position==Vector2i(1,0),"equal-distance tie remains deterministic")
		small.place_item(item(1,1),Vector2i(1,0))
		candidate=resolver.resolve_grid(tiny,small,Vector2(10,10),Vector2.ZERO,20.0)
		check(candidate.position==Vector2i(0,1),"occupied nearest skipped for another within radius")
		small.place_item(item(1,1),Vector2i(0,1))
		small.place_item(item(1,1),Vector2i(1,1))
		check(not resolver.resolve_grid(tiny,small,Vector2(10,10),Vector2.ZERO,20.0).valid,"no free local candidate gives invalid")
		var counted:=CountingGrid.new(5,5)
		counted.place_item(item(1,1),Vector2i.ZERO)
		counted.checks=0
		resolver.resolve_grid(tiny,counted,Vector2(10,10),Vector2.ZERO,20.0)
		check(counted.checks<=9,"snap checks only raw plus local8 neighbors")
		var ammo:=InventoryItemInstance.new(load("res://data/items/weapon1_level2_ammo_item.tres"),60)
		var loaded:=MagazineInstance.new()
		loaded.initialize_full(load("res://data/magazines/test_30rd_magazine.tres"))
		for i in range(13): loaded.pop_round()
		var mag_item:=InventoryItemInstance.new(load("res://data/items/magazine_1_item.tres"),1,loaded)
		var special:=InventoryGrid.new(3,3)
		special.place_item(mag_item,Vector2i.ZERO)
		var ammo_context: Variant=context_script.new(ammo,48.0,Vector2(24,24))
		candidate=resolver.resolve_grid(ammo_context,special,Vector2(20,75),Vector2.ZERO)
		check(candidate.valid and candidate.kind==&"load" and candidate.target_item==mag_item,"ammo lower magazine cell highlights whole load target")
		check(candidate.position==Vector2i.ZERO and loaded.get_round_count()==17 and ammo.stack_count==60,"load preview leaves ammo and rounds unchanged")
		loaded.definition=loaded.definition.duplicate()
		loaded.definition.compatible_ammo_type_ids.clear()
		candidate=resolver.resolve_grid(ammo_context,special,Vector2(20,75),Vector2.ZERO)
		check(not candidate.valid and candidate.kind==&"load","wrong ammo shows invalid load without placement fallback")
		var stack:=InventoryItemInstance.new(ammo.definition,30)
		special.place_item(stack,Vector2i(1,0))
		candidate=resolver.resolve_grid(ammo_context,special,Vector2(65,20),Vector2.ZERO)
		check(candidate.valid and candidate.kind==&"stack" and candidate.target_item==stack,"same ammo stack has special stack preview")
		stack.stack_count=60
		check(not resolver.resolve_grid(ammo_context,special,Vector2(65,20),Vector2.ZERO).valid,"full stack is invalid")
		stack.stack_count=30
		stack.definition=stack.definition.duplicate()
		stack.definition.item_id=&"different_stack"
		check(not resolver.resolve_grid(ammo_context,special,Vector2(65,20),Vector2.ZERO).valid,"wrong stack ID is invalid")
		var inv:=PlayerInventoryComponent.new()
		var gun:=InventoryItemInstance.new(load("res://data/items/primary_weapon_1_item.tres"),1,WeaponRuntime.new())
		var gun_context: Variant=context_script.new(gun)
		check(resolver.resolve_equipment(gun_context,inv.equipment,0).valid,"primary weapon valid equipment target")
		check(not resolver.resolve_equipment(gun_context,inv.equipment,2).valid,"primary weapon invalid pistol target")
		inv.free()
	print("INVENTORY_DRAG_CANDIDATE_RESULT assertions=%d failures=%d"%[assertions,failures])
	quit(1 if failures else 0)
