extends "res://tests/recursive_weight_test.gd"

func _run() -> void:
	check(FileAccess.file_exists("res://scripts/inventory/inventory_reservation.gd"),"explicit ownership reservation exists")
	if failures:
		finish_reservations()
		return
	var service: Variant=InventoryTransactionService.new()
	var grid:=InventoryGrid.new(10,10)
	service.register_grid(grid)
	var nested:=bag()
	nested.runtime_state.grid.place_item(ammo(10),Vector2i.ZERO)
	check(service.place_complete_subtree(nested,grid,Vector2i.ZERO),"fixture places complete populated subtree")
	var before: float=InventoryWeightCalculator.get_registry_total_weight(service).weight_kg
	var lease: Variant=service.reserve_item(nested)
	check(lease!=null and service.get_location(nested).kind==&"transit","grid becomes explicitly reserved transit")
	check(nested.get_owner_registry()==service and service.get_location_count(nested)==1,"reserved root retains registry and exactly one logical location")
	check(weight_is(InventoryWeightCalculator.get_registry_total_weight(service),before),"reserved nested subtree retains full weight")
	check(service.reserve_item(nested)==null,"duplicate reservation refused")
	check(not service.move(nested,grid,Vector2i(5,5)),"ordinary movement cannot steal a reserved item")
	check(not service.commit_reservation(lease,{"kind":&"grid","grid":grid,"position":Vector2i(20,20)}),"failed destination commit has zero mutation")
	check(weight_is(InventoryWeightCalculator.get_registry_total_weight(service),before) and service.is_reserved(nested),"failed commit retains weight and reservation")
	check(service.cancel_reservation(lease),"cancel restores original location")
	check(grid.get_placement(nested).position==Vector2i.ZERO and weight_is(InventoryWeightCalculator.get_registry_total_weight(service),before),"cancel preserves identity subtree rotation and weight")
	lease=service.reserve_item(nested)
	check(service.commit_reservation(lease,{"kind":&"grid","grid":grid,"position":Vector2i(5,5),"rotated":false}),"reservation to grid commits")
	check(not service.is_reserved(nested) and weight_is(InventoryWeightCalculator.get_registry_total_weight(service),before),"commit removes lease without double count")
	var gun:=InventoryItemFactory.create(load("res://data/items/primary_weapon_1_item.tres"))
	grid.place_item(gun,Vector2i.ZERO)
	var child: InventoryItemInstance=service.find_runtime_item(gun.runtime_state.loaded_magazine)
	before=InventoryWeightCalculator.get_registry_total_weight(service).weight_kg
	lease=service.reserve_item(child,false)
	check(lease!=null and service.get_location_count(child)==1 and service.get_direct_parent(child).parent_item==gun,"tracking attached item adds no second ownership edge")
	gun.runtime_state.loaded_magazine=null
	check(service.get_location(child).kind==&"transit" and service.get_location_count(child)==1,"detached weapon magazine immediately becomes reservation root")
	check(weight_is(InventoryWeightCalculator.get_registry_total_weight(service),before),"weapon magazine detach has no weight gap")
	gun.runtime_state.loaded_magazine=child.runtime_state
	check(service.finish_reservation(lease) and weight_is(InventoryWeightCalculator.get_registry_total_weight(service),before),"reservation to weapon restores edge without double count")
	var crate:=LootContainerRuntime.new()
	crate.transactions.register_external_container(crate)
	var round_item:=ammo(10)
	crate.inventory_grid.place_item(round_item,Vector2i.ZERO)
	lease=crate.transactions.reserve_item(round_item)
	check(weight_is(InventoryWeightCalculator.get_registry_total_weight(crate.transactions),0.12),"external registry reservation uses same generic root rule")
	check(crate.transactions.cancel_reservation(lease),"external reservation cancel restores grid")
	var plain: InventoryItemInstance=item(1,1)
	plain.definition.weight=0.7
	grid.place_item(plain,Vector2i(9,9))
	before=InventoryWeightCalculator.get_registry_total_weight(service).weight_kg
	lease=service.reserve_item(plain)
	check(weight_is(InventoryWeightCalculator.get_registry_total_weight(service),before),"generic future item reserved without weight type branch")
	service.cancel_reservation(lease)
	var inv:=PlayerInventoryComponent.new()
	var rig:=InventoryItemFactory.create(load("res://data/items/rig_1.tres"))
	inv.transactions.equip(rig,4)
	var reload_gun:=InventoryItemFactory.create(load("res://data/items/primary_weapon_1_item.tres"))
	for index in range(12): reload_gun.runtime_state.loaded_magazine.pop_round()
	inv.transactions.equip(reload_gun,0)
	var coord: Variant=ReloadCoordinator.new()
	coord.configure(inv)
	inv.get_equipped_rig().grids[0].place_item(mag(),Vector2i.ZERO)
	var runtime: WeaponRuntime=inv.equipment.get_active_item().runtime_state
	before=inv.get_total_weight()
	var snapshots: Array[float]=[]
	runtime.state_changed.connect(func(): snapshots.append(inv.get_total_weight()))
	runtime.reload_finished.connect(func(_result: WeaponReloadResult): snapshots.append(inv.get_total_weight()))
	check(coord.request_reload(),"tactical begins")
	check(is_equal_approx(inv.get_total_weight(),before),"tactical start retains weight")
	runtime.tick(1.0)
	check(is_equal_approx(inv.get_total_weight(),before),"tactical midpoint retains weight")
	check(coord.cancel_reload(),"reload cancellation available")
	check(is_equal_approx(inv.get_total_weight(),before) and runtime.loaded_magazine.get_round_count()==17 and not inv.transactions.locked,"reload cancel restores exact weapon and original grid")
	check(coord.request_reload(),"tactical retry begins")
	runtime.tick(2.0)
	check(is_equal_approx(inv.get_total_weight(),before),"tactical after retains weight")
	for value in snapshots: check(is_equal_approx(value,before),"every runtime notification observes continuous weight")
	snapshots.clear()
	runtime.try_fire()
	runtime.tick(1.0)
	before=inv.get_total_weight()
	var outgoing: InventoryItemInstance=inv.find_runtime_item(runtime.loaded_magazine)
	var mass: float=outgoing.get_weight()
	check(coord.request_reload(WeaponRuntime.ReloadType.DROP),"drop reload begins")
	check(is_equal_approx(inv.get_total_weight(),before),"RR before commit remains carried")
	runtime.tick(1.0)
	check(is_equal_approx(inv.get_total_weight(),before),"RR midpoint remains carried")
	runtime.tick(1.0)
	check(is_equal_approx(inv.get_total_weight(),before-mass) and inv.transactions.get_location(outgoing).kind==&"world","RR loses exact outgoing weight only at WORLD commit")
	coord.free()
	inv.free()
	finish_reservations()

func finish_reservations() -> void:
	print("RESERVATION_OWNERSHIP_RESULT assertions=%d failures=%d"%[assertions,failures])
	quit(1 if failures else 0)

