extends "res://tests/recursive_weight_test.gd"

func _run() -> void:
	var level: Node3D=load("res://scenes/levels/test_level.tscn").instantiate()
	root.add_child(level)
	current_scene=level
	var p: Variant=level.get_node("Player")
	p.set_physics_process(false)
	p.firearm.set_physics_process(false)
	var inv: PlayerInventoryComponent=p.inventory
	var ui: InventoryUI=p.get_node("InventoryUI")
	ui.toggle()
	var a: InventoryItemInstance=inv.equipment.slots[5]
	var b:=bag()
	var c:=bag()
	a.runtime_state.grid.place_item(b,Vector2i(1,0))
	b.runtime_state.grid.place_item(c,Vector2i.ZERO)
	var wa:=ui.open_portable_container(a)
	var wb:=ui.open_portable_container(b,wa)
	ui.open_portable_container(c,wb)
	var ids: Array=[a.get_instance_id(),b.get_instance_id(),c.get_instance_id(),a.runtime_state.get_instance_id()]
	var before: float=inv.get_total_weight()
	ui.portable_windows.close_window(wa)
	check(ui.portable_windows.windows.is_empty(),"parent close recursively closes entire opening subtree")
	check(ids==[a.get_instance_id(),b.get_instance_id(),c.get_instance_id(),a.runtime_state.get_instance_id()] and is_equal_approx(inv.get_total_weight(),before),"closing views has no storage/runtime mutation")
	wa=ui.open_portable_container(a)
	wb=ui.open_portable_container(b,wa)
	ui.open_portable_container(c,wb)
	var original: InventoryItemInstance=a.runtime_state.grid.get_item_at_cell(Vector2i.ZERO)
	ui.begin_drag(original)
	ui.portable_windows.close_window(wa)
	check(ui.drag_context==null,"source window close cancels in-flight drag")
	wa=ui.open_portable_container(a)
	wb=ui.open_portable_container(b,wa)
	ui.open_portable_container(c,wb)
	var dropped:=inv.transactions.drop_item_to_world(a,level,WorldItemFactory.grounded_drop_transform(p))
	check(ui.portable_windows.windows.is_empty(),"WORLD root commit closes root and descendant windows")
	check(is_equal_approx(inv.get_total_weight(),before-a.get_weight()),"window lifecycle never caches carried weight after WORLD change")
	check(inv.transactions.pickup_world_item(dropped).success,"whole portable root returns")
	wa=ui.open_portable_container(a)
	wa.refresh_contents()
	check(wa.weight_label.text.contains("%.2f"%a.get_weight()),"window header uses shared recursive total")
	ui.portable_windows.before_close=func(member: InventoryItemInstance): member.set_meta("b2_close_hook",true)
	ui.portable_windows.close_window(wa)
	check(a.get_meta("b2_close_hook",false),"future close cleanup hook invoked without round gameplay")
	ui.portable_windows.before_close=Callable()
	var layout:=PortableContainerData.new()
	layout.definition_id=&"b2_heterogeneous_rig"
	layout.grid_sizes.assign([Vector2i(2,2),Vector2i(3,1),Vector2i(1,3)])
	var definition:=ItemDefinition.new()
	definition.category=ItemDefinition.Category.RIG
	definition.item_id=&"b2_dynamic_rig"
	definition.grid_size=Vector2i(2,2)
	definition.container_data=layout
	var rig:=InventoryItemFactory.create(definition)
	check(inv.transactions.place(rig,c.runtime_state.grid,Vector2i.ZERO),"dynamic Rig registers under nested bag")
	var wr:=ui.open_portable_container(rig)
	check(wr!=null and wr.views.size()==3,"heterogeneous layout drives exact view count")
	for index in range(3): check(wr.views[index].grid==rig.get_storage_grids()[index] and wr.views[index].grid.size==layout.grid_sizes[index],"heterogeneous actual grid identity and dimensions")
	check(ItemInspection.describe(rig).storage_sizes==layout.grid_sizes,"Inspect reports actual dynamic Rig layout")
	ui.portable_windows.close_all()
	ui.toggle()
	var crate: LootContainer=level.get_node("LootCrateA")
	p.global_position=crate.global_position+Vector3(0,0,1.8)
	p.camera.look_at(crate.get_interaction_position())
	await physics_frame
	check(ui.open_container(crate),"actual crate access for portable transfer")
	for placement in crate.runtime.inventory_grid.placements.duplicate():
		crate.runtime.transactions.remove(placement.item)
	wa=ui.open_portable_container(a)
	wb=ui.open_portable_container(b,wa)
	check(ExternalInventoryTransfer.transfer(ui.container_access,a,crate.runtime.transactions,{"kind":&"grid","grid":crate.runtime.inventory_grid,"position":Vector2i(4,0)}),"actual nested root crosses Player to Crate")
	ui.portable_windows.validate_windows()
	check(ui.portable_windows.windows.is_empty(),"owner registry change closes all subtree windows")
	var actions:=ItemActionResolver.resolve(a,ui)
	check(actions.size()==2 and actions[0].id==&"inspect" and actions[1].id==&"open_container","Crate portable offers Inspect/Open and no Drop")
	wa=ui.open_portable_container(a)
	check(wa!=null and wa.views[0].grid.get_transactions()==crate.runtime.transactions,"Crate window views actual external registry grid")
	ui.show_item_context(b,Vector2(300,200),wa)
	p.global_position+=Vector3(10,0,0)
	ui.portable_windows.validate_windows()
	ui.item_context.validate_context()
	check(ui.portable_windows.windows.is_empty() and not ui.item_context.visible,"expired crate access invalidates windows and stale context")
	check(ui.open_portable_container(a)==null,"inaccessible external item cannot reopen")
	ui.toggle()
	level.queue_free()
	await process_frame
	print("PORTABLE_WINDOW_LIFECYCLE_RESULT assertions=%d failures=%d"%[assertions,failures])
	quit(1 if failures else 0)
