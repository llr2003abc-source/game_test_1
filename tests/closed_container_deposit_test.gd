extends "res://tests/recursive_weight_test.gd"

func portable(extent: Vector2i, grids: Array[Vector2i], rig: bool=false) -> InventoryItemInstance:
	var definition: ItemDefinition=load("res://data/items/rig_1.tres" if rig else "res://data/items/backpack_1.tres").duplicate()
	definition.grid_size=extent
	definition.container_data=PortableContainerData.new()
	definition.container_data.grid_sizes=grids
	return InventoryItemFactory.create(definition)

func hover(incoming: InventoryItemInstance, target: InventoryItemInstance, outer: InventoryGrid) -> Dictionary:
	return InventoryDragCandidateResolver.resolve_grid(InventoryDragContext.new(incoming),outer,Vector2(outer.get_placement(target).position)*48+Vector2(12,12),Vector2.ZERO)

func _run() -> void:
	var service:=InventoryTransactionService.new()
	var outer:=InventoryGrid.new(10,8)
	service.register_grid(outer)
	var target:=bag()
	outer.place_item(target,Vector2i(4,0))
	var incoming:=ammo()
	outer.place_item(incoming,Vector2i.ZERO)
	var context:=InventoryDragContext.new(incoming)
	var candidate:=InventoryDragCandidateResolver.resolve_grid(context,outer,Vector2(4*48+12,12),Vector2.ZERO)
	check(candidate.kind==&"container_content","hover actual portable creates content candidate")
	check(candidate.valid,"empty actual closed target accepts ammo")
	check(candidate.get("grid")==target.get_storage_grids()[0],"candidate targets actual internal grid rather than parent")
	check(candidate.get("position")==Vector2i.ZERO,"closed content deterministic first fit is0,0")
	check(outer.get_placement(incoming)!=null and target.get_storage_grids()[0].placements.is_empty(),"preview changes no item ownership or placements")
	for incoming_item in [mag(17),InventoryItemFactory.create(load("res://data/items/primary_weapon_1_item.tres")),bag(),InventoryItemFactory.create(load("res://data/items/rig_1.tres")),item(2,3)]:
		var next:=hover(incoming_item,target,outer)
		check(next.kind==&"container_content" and next.valid,"different item capability uses actual closed target: "+str(incoming_item.definition.category))
	var self_target:=hover(target,target,outer)
	check(self_target.kind==&"container_content" and not self_target.valid,"grid own portable footprint is self-invalid")
	var tiny:=portable(Vector2i(1,1),[Vector2i(3,2)])
	outer.place_item(tiny,Vector2i(9,0))
	var two_by_three: InventoryItemInstance=item(2,3)
	var mismatch:=hover(two_by_three,tiny,outer)
	check(not mismatch.valid and not two_by_three.rotated,"manual2x3 does not automatically fit3x2")
	var rotated:=InventoryDragContext.new(two_by_three)
	rotated.rotate_preview()
	var after_rotate:=InventoryDragCandidateResolver.resolve_grid(rotated,outer,Vector2(9*48+12,12),Vector2.ZERO)
	check(after_rotate.valid and after_rotate.rotated and not two_by_three.rotated,"user rotation recomputes valid actual3x2 placement")
	var fill: InventoryItemInstance=item(3,2)
	tiny.get_storage_grids()[0].place_item(fill,Vector2i.ZERO)
	var full:=hover(incoming,tiny,outer)
	check(full.kind==&"container_content" and not full.valid and full.get("reason")==&"NO_SPACE","full target keeps no-space content semantics")
	var custom_rig:=portable(Vector2i(1,1),[Vector2i(1,1),Vector2i(2,2),Vector2i(3,1)],true)
	outer.place_item(custom_rig,Vector2i(9,1))
	custom_rig.get_storage_grids()[0].place_item(item(1,1),Vector2i.ZERO)
	var multi:=hover(incoming,custom_rig,outer)
	check(multi.valid and multi.grid==custom_rig.get_storage_grids()[1] and multi.position==Vector2i.ZERO,"direct grids searched in actual runtime order")
	check(not hover(bag(),custom_rig,outer).valid,"portable into rig rejected even with available geometry")
	var child:=portable(Vector2i(5,5),[Vector2i(5,5)])
	service.place_complete_subtree(child,target.get_storage_grids()[0],Vector2i.ZERO)
	check(not hover(incoming,target,outer).valid and child.get_storage_grids()[0].placements.is_empty(),"full direct grid never searches spacious descendant")
	var sibling:=portable(Vector2i(1,1),[Vector2i(5,5)])
	outer.place_item(sibling,Vector2i(9,2))
	check(not hover(incoming,target,outer).valid and sibling.get_storage_grids()[0].placements.is_empty(),"full hovered target never searches sibling")
	check(not hover(target,child,target.get_storage_grids()[0]).valid,"ancestor into descendant rejected by common cycle graph")
	var fragmented:=portable(Vector2i(1,1),[Vector2i(3,3)])
	outer.place_item(fragmented,Vector2i(9,3))
	fragmented.get_storage_grids()[0].place_item(item(1,3),Vector2i(1,0))
	check(not hover(item(2,2),fragmented,outer).valid,"fragmented six free cells cannot hold2x2 and no rearrangement")
	check(fragmented.get_storage_grids()[0].placements[0].position==Vector2i(1,0),"preview never rearranges existing item")
	var lease:=service.reserve_item(sibling,false)
	check(not hover(incoming,sibling,outer).valid,"reserved target is not available for content deposit")
	service.finish_reservation(lease)
	service.locked=true
	check(not hover(incoming,sibling,outer).valid,"registry locked blocks target even with free cells")
	service.locked=false
	var chain:=portable(Vector2i.ONE,[Vector2i.ONE])
	var leaf:=chain
	for depth in range(32):
		var next:=portable(Vector2i.ONE,[Vector2i.ONE])
		leaf.get_storage_grids()[0]._commit_place(next,Vector2i.ZERO,false)
		leaf=next
	check(service.place_complete_subtree(chain,outer,Vector2i(9,4)),"legal depth32 fixture registered")
	var too_deep:=hover(incoming,leaf,leaf.get_owner_registry().get_direct_parent(leaf).grid)
	check(not too_deep.valid and too_deep.kind==&"container_content","depth33 content target rejected by existing graph")
	var alias:=InventoryItemInstance.new(sibling.definition,1,sibling.runtime_state)
	check(not hover(alias,sibling,outer).valid,"runtime alias does not bypass closed-target validation")
	var corrupted:=portable(Vector2i.ONE,[Vector2i(2,2)])
	outer.place_item(corrupted,Vector2i(9,5))
	var repeated: InventoryItemInstance=item(1,1)
	corrupted.get_storage_grids()[0]._commit_place(repeated,Vector2i.ZERO,false)
	corrupted.get_storage_grids()[0]._commit_place(repeated,Vector2i(1,0),false)
	check(not hover(incoming,corrupted,outer).valid,"alias in target contents cannot show valid deposit")
	corrupted.get_storage_grids()[0].placements.clear()
	print("CLOSED_CONTAINER_DEPOSIT_RESULT assertions=%d failures=%d"%[assertions,failures])
	quit(1 if failures else 0)
