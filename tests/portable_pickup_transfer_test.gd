extends "res://tests/ownership_subtree_test.gd"

func _run() -> void:
	var source:=bag()
	check(source.get_size()==Vector2i(4,5) and source.get_size(true)==Vector2i(5,4),"Backpack1 footprint has twenty cells in either orientation")
	check(source.runtime_state.grid.size==Vector2i(5,5),"external redesign does not change internal capacity")
	var actor:=Node3D.new()
	root.add_child(actor)
	var inv:=PlayerInventoryComponent.new()
	actor.add_child(inv)
	var parent:=bag()
	check(inv.transactions.equip(parent,5),"equip root Backpack")
	check(parent.runtime_state.grid.place_item(item(5,1),Vector2i(0,4)),"existing final-row blocker creates only five-by-four free space")
	var planned: Dictionary=PickupPlacementPolicy.find_destination(inv,source)
	check(not planned.is_empty() and planned.get("grid")==parent.runtime_state.grid and planned.get("rotated",false),"F plans rotated Backpack when current four-by-five cannot fit")
	check(not source.rotated,"planning never mutates incoming rotation")
	var world:=WorldItemFactory.spawn(source,inv.transactions,actor,Transform3D.IDENTITY)
	var preview: PickupPreviewResult=inv.transactions.preview_world_pickup(world)
	check(preview.can_accept_all,"Preview agrees with rotated automatic plan")
	check(inv.transactions.pickup_world_item(world).success and source.rotated,"real pickup commits incoming rotation and root nesting")
	check(inv.transactions.get_direct_parent(source).parent_item==parent,"rotated pickup enters only equipped root")
	check(parent.runtime_state.grid.placements[0].item.get_size()==Vector2i(5,1),"automatic pickup never rearranges existing blocker")
	var second:=bag()
	var world2:=WorldItemFactory.spawn(second,inv.transactions,actor,Transform3D.IDENTITY)
	check(source.runtime_state.grid.placements.is_empty(),"nested Backpack has free storage")
	check(not inv.transactions.preview_world_pickup(world2).can_accept_all and not inv.transactions.pickup_world_item(world2).success,"root full rejects pickup even though nested bag empty")
	check(second.get_owner_registry()==inv.transactions and inv.transactions.get_location(second).kind==&"world" and not second.rotated,"failed pickup keeps WORLD identity and orientation")
	world2.retire()
	var corrupt:=bag()
	var corrupt_world:=WorldItemFactory.spawn(corrupt,inv.transactions,actor,Transform3D.IDENTITY)
	var leaf: InventoryItemInstance=item(1,1)
	corrupt.runtime_state.grid._commit_place(leaf,Vector2i.ZERO,false)
	corrupt.runtime_state.grid._commit_place(leaf,Vector2i(1,0),false)
	inv.transactions.remove(parent)
	check(not inv.transactions.preview_world_pickup(corrupt_world).can_accept_all,"corrupt WORLD subtree preview rejects even with free equipment slot")
	check(not inv.transactions.pickup_world_item(corrupt_world).success and inv.equipment.slots[5]==null,"corrupt pickup matches preview and leaves equipment untouched")
	corrupt.runtime_state.grid.placements.clear()
	corrupt_world.retire()
	inv.transactions.equip(parent,5)
	var rig:=InventoryItemFactory.create(load("res://data/items/rig_1.tres"))
	var rig_world:=WorldItemFactory.spawn(rig,inv.transactions,actor,Transform3D.IDENTITY)
	check(inv.transactions.pickup_world_item(rig_world).success and inv.equipment.slots[4]==rig,"empty Rig equipment slot wins before root bag")
	var extra_rig:=InventoryItemFactory.create(load("res://data/items/rig_1.tres"))
	var extra_world:=WorldItemFactory.spawn(extra_rig,inv.transactions,actor,Transform3D.IDENTITY)
	check(not inv.transactions.pickup_world_item(extra_world).success,"occupied Rig and full root cannot search nested bag")
	for pocket in inv.pockets: pocket.place_item(item(1,1),Vector2i.ZERO)
	for compartment in rig.runtime_state.grids: compartment.place_item(item(compartment.size.x,compartment.size.y),Vector2i.ZERO)
	for definition_path in ["res://data/items/magazine_1_item.tres","res://data/items/weapon1_level2_ammo_item.tres"]:
		var extra:=InventoryItemFactory.create(load(definition_path))
		check(PickupPlacementPolicy.find_destination(inv,extra).is_empty(),"normal F does not search empty nested storage or Secure: "+definition_path)
	actor.queue_free()
	await process_frame
	await transfers()
	finish_pickup()

func transfers() -> void:
	var actor:=Node3D.new()
	root.add_child(actor)
	var inv:=PlayerInventoryComponent.new()
	actor.add_child(inv)
	var owner: Variant=load("res://tests/container_test_owner.gd").new()
	root.add_child(owner)
	var crate: LootContainerRuntime=owner.runtime
	check(crate.transactions.register_external_container(crate),"external empty registry prepared")
	var a:=bag()
	var b:=bag()
	var rig:=InventoryItemFactory.create(load("res://data/items/rig_1.tres"))
	var mag:=InventoryItemFactory.create(load("res://data/items/magazine_1_item.tres"),1,17)
	b.rotated=true
	a.runtime_state.grid.place_item(b,Vector2i.ZERO)
	b.runtime_state.grid.place_item(rig,Vector2i(1,1))
	rig.runtime_state.grids[2].place_item(mag,Vector2i.ZERO)
	check(inv.transactions.equip(a,5),"high-level equip explicitly registers complete nested root")
	var carried_weight: float=inv.get_total_weight()
	var container_weight: float=crate.get_contents_weight()
	var identities: Array=[a,b,rig,mag,a.runtime_state,b.runtime_state,rig.runtime_state,mag.runtime_state,mag.runtime_state.rounds.duplicate(),b.rotated,b.runtime_state.grid.get_placement(rig).position]
	var access:=LootContainerAccess.new(actor,owner,inv.transactions)
	check(not ExternalInventoryTransfer.transfer(access,a,crate.transactions,{"kind":&"grid","grid":crate.inventory_grid,"position":Vector2i(7,5)}),"bad destination rejects before transfer")
	check(inv.equipment.slots[5]==a and crate.transactions.items.is_empty() and a.get_owner_registry()==inv.transactions,"bad transfer preserves both registry domains")
	check(ExternalInventoryTransfer.transfer(access,a,crate.transactions,{"kind":&"grid","grid":crate.inventory_grid,"position":Vector2i.ZERO}),"nested root transfers Player to Crate")
	check(is_equal_approx(carried_weight-inv.get_total_weight(),crate.get_contents_weight()-container_weight),"Player/Crate recursive weight deltas are equal and opposite")
	for member in [a,b,rig,mag]:
		check(member.get_owner_registry()==crate.transactions and not inv.transactions.items.has(member),"entire subtree crosses registry together")
	check(ExternalInventoryTransfer.transfer(access,a,inv.transactions,{"kind":&"equipment","slot":5}),"same identities return Crate to Player")
	check(is_equal_approx(carried_weight,inv.get_total_weight()) and is_equal_approx(container_weight,crate.get_contents_weight()),"Crate return restores both recursive totals")
	check(identities==[a,b,rig,mag,a.runtime_state,b.runtime_state,rig.runtime_state,mag.runtime_state,mag.runtime_state.rounds.duplicate(),b.rotated,b.runtime_state.grid.get_placement(rig).position],"all identities, actual round sequence, rotations and placements retained")
	var dropped:=inv.transactions.drop_item_to_world(a,actor,Transform3D.IDENTITY)
	check(dropped!=null and inv.transactions.world_items.size()==1,"WORLD drop creates only outer root visual")
	check(inv.transactions.get_location(mag).kind==&"grid" and inv.transactions.get_direct_parent(mag).parent_item==rig,"WORLD descendants retain internal parent locations")
	check(inv.transactions.pickup_world_item(dropped).success and inv.equipment.slots[5]==a,"F retrieves whole populated WORLD root into empty equipment slot")
	check(inv.transactions.find_runtime_item(mag.runtime_state)==mag,"WORLD round-trip preserves actual child wrapper")
	access.close()
	owner.queue_free()
	actor.queue_free()
	await process_frame

func finish_pickup() -> void:
	print("PORTABLE_PICKUP_TRANSFER_RESULT assertions=%d failures=%d"%[assertions,failures])
	quit(1 if failures else 0)
