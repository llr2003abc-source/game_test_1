extends "res://tests/rig_reload_test.gd"
func _run() -> void:
	for source_kind in [&"backpack",&"secure",&"pocket",&"unequipped_rig"]:
		var inv: Variant=fixture()
		var coord:=ReloadCoordinator.new()
		coord.configure(inv)
		var mag: Variant=magazine(30)
		if source_kind==&"backpack":
			var bag:=InventoryItemInstance.new(load("res://data/items/backpack_1.tres"),1,BackpackContainerRuntime.new())
			inv.transactions.equip(bag,5)
			bag.runtime_state.grid.place_item(mag,Vector2i.ZERO)
		elif source_kind==&"secure": inv.secure.grid.place_item(mag,Vector2i.ZERO)
		elif source_kind==&"pocket":
			mag.definition=mag.definition.duplicate()
			mag.definition.grid_size=Vector2i.ONE
			inv.pockets[0].place_item(mag,Vector2i.ZERO)
		else:
			inv.get_equipped_rig().grids[0].place_item(mag,Vector2i.ZERO)
			var rig: Variant=inv.equipment.slots[4]
			inv.transactions.move(rig,inv.secure.grid,Vector2i.ZERO)
		check(coord.select_reload_magazine()==null,"only equipped rig: "+str(source_kind))
		for type in [1,2]: check(not coord.request_reload(type) and inv.transactions.world_items.is_empty(),"excluded sources never reload/drop")
		coord.free()
		inv.free()
	for empty in [false,true]:
		var inv: Variant=fixture()
		var coord:=ReloadCoordinator.new()
		coord.configure(inv)
		var runtime: WeaponRuntime=inv.equipment.get_active_item().runtime_state
		var old: Variant=inv.find_runtime_item(runtime.loaded_magazine)
		if empty:
			runtime.loaded_magazine.clear()
			runtime.chambered_round=null
			runtime.state=WeaponRuntime.State.EMPTY
		var replacement: Variant=magazine(30)
		inv.get_equipped_rig().grids[0].place_item(replacement,Vector2i.ZERO)
		check(coord.request_reload(),"tactical/empty formal reload")
		check(not inv.equipment.select_weapon_slot(0) and not inv.transactions.remove(old),"all slot changes locked during reload")
		runtime.tick(2.0)
		check(runtime.get_magazine_round_count()==(29 if empty else 30) and runtime.chambered_round!=null,"empty29+1 versus tactical30+1")
		check(inv.find_runtime_item(runtime.loaded_magazine)==replacement and inv.transactions.get_location(old).kind==&"grid","registry resolves result originals")
		coord.free()
		inv.free()
	var inv: Variant=fixture()
	var coord:=ReloadCoordinator.new()
	coord.configure(inv)
	var runtime: WeaponRuntime=inv.equipment.get_active_item().runtime_state
	var old: Variant=inv.find_runtime_item(runtime.loaded_magazine)
	for grid in inv.get_equipped_rig().grids:
		var candidate: Variant=magazine(30)
		candidate.definition=candidate.definition.duplicate()
		candidate.definition.grid_size=Vector2i.ONE
		grid.place_item(candidate,Vector2i.ZERO)
	check(coord.request_reload() and runtime.reload_type==WeaponRuntime.ReloadType.DROP,"four isolated free cells cannot fit old1x2")
	runtime.tick(2.0)
	check(inv.transactions.get_location(old).kind==&"world","fragmented space causes one drop")
	coord.free()
	inv.free()
	inv=fixture()
	coord=ReloadCoordinator.new()
	coord.configure(inv)
	runtime=inv.equipment.get_active_item().runtime_state
	old=inv.find_runtime_item(runtime.loaded_magazine)
	inv.transactions.register_item(old)
	runtime.loaded_magazine=null
	inv.get_equipped_rig().grids[0].place_item(magazine(30),Vector2i.ZERO)
	check(coord.request_reload(2),"drop reload without current magazine")
	runtime.tick(2.0)
	check(inv.transactions.world_items.is_empty() and runtime.get_magazine_round_count()==30,"no old magazine creates no phantom drop and retains chamber")
	coord.free()
	inv.free()
	inv=fixture()
	var a: Variant=item(1,1)
	inv.pockets[0].place_item(a,Vector2i.ZERO)
	check(not inv.pockets[1].remove_item(a) and inv.pockets[0].get_placement(a)!=null,"wrong-grid remove does not steal item")
	check(not inv.pockets[1].move_item(a,Vector2i.ZERO) and inv.pockets[0].get_placement(a)!=null,"grid move requires ownership; service transfers separately")
	for slot in [2,4,5]:
		if inv.equipment.slots[slot]!=null: inv.transactions.remove(inv.equipment.slots[slot])
		var malformed: Variant=item(1,1)
		malformed.definition.category={2:5,4:7,5:8}[slot]
		check(not inv.transactions.equip(malformed,slot),"runtime category required for equipment")
	inv.free()
	var service:=InventoryTransactionService.new()
	var secure:=InventoryGrid.new(3,3,&"secure")
	service.register_grid(secure)
	var ammo_definition: ItemDefinition=load("res://data/items/weapon1_level2_ammo_item.tres")
	var ammo:=InventoryItemInstance.new(ammo_definition,40)
	var target:=InventoryItemInstance.new(ammo_definition,30)
	secure.place_item(ammo,Vector2i.ZERO)
	secure.place_item(target,Vector2i(1,0))
	check(service.merge_stacks(ammo,target)==30 and ammo.stack_count==10 and target.stack_count==60,"secure stack40+30=>10+60")
	var split:=service.split_stack(target,20)
	check(split!=null and split.stack_count==20 and target.stack_count==40,"secure split20 conserves rounds")
	var mag1: Variant=magazine(0)
	var mag2: Variant=magazine(0)
	service.register_item(mag1)
	service.register_item(mag2)
	check(service.load_ammo_into_magazine(target,mag1,30)==30,"empty mag receives30")
	check(service.load_ammo_into_magazine(target,mag2,30)==10 and not service.items.has(target),"remaining10 consumed, zero stack removed")
	check(mag1.runtime_state.get_round_count()+mag2.runtime_state.get_round_count()+ammo.stack_count+split.stack_count==70,"all rounds conserved through load/stack/split")
	inv=PlayerInventoryComponent.new()
	var populated_rig:=RigContainerRuntime.new()
	var populated_mag: Variant=magazine(17)
	populated_rig.grids[0].place_item(populated_mag,Vector2i.ZERO)
	var populated_item:=InventoryItemInstance.new(load("res://data/items/rig_1.tres"),1,populated_rig)
	check(inv.transactions.equip(populated_item,4),"prepopulated rig equips through transaction")
	check(inv.find_runtime_item(populated_mag.runtime_state)==populated_mag and inv.transactions.items.has(populated_mag),"prepopulated contents registered by identity")
	check(inv.transactions.get_location(populated_mag).kind==&"grid","adopted content has unique owned grid")
	var dup: Variant=InventoryItemInstance.new(populated_mag.definition,1,populated_mag.runtime_state)
	var bad_bag:=BackpackContainerRuntime.new()
	bad_bag.grid.place_item(dup,Vector2i.ZERO)
	var bad_item:=InventoryItemInstance.new(load("res://data/items/backpack_1.tres"),1,bad_bag)
	var original_count: int=inv.transactions.items.size()
	check(not inv.transactions.equip(bad_item,5),"container adoption rejects duplicated contained runtime")
	check(inv.equipment.slots[5]==null and inv.transactions.items.size()==original_count and bad_bag.grid.get_placement(dup)!=null,"failed adoption has no partial ownership/registry changes")
	var shared_bag:=BackpackContainerRuntime.new()
	shared_bag.grid.place_item(populated_mag,Vector2i.ZERO)
	var shared_item:=InventoryItemInstance.new(load("res://data/items/backpack_1.tres"),1,shared_bag)
	check(not inv.transactions.equip(shared_item,5) and inv.transactions.get_location(populated_mag).grid==populated_rig.grids[0],"adoption cannot steal item already owned by another grid")
	var duplicate_rig:=RigContainerRuntime.new()
	var duplicate_mag: Variant=magazine(30)
	duplicate_rig.grids[0].place_item(duplicate_mag,Vector2i.ZERO)
	duplicate_rig.grids[1].place_item(duplicate_mag,Vector2i.ZERO)
	inv.transactions.remove(populated_item)
	check(not inv.transactions.equip(InventoryItemInstance.new(load("res://data/items/rig_1.tres"),1,duplicate_rig),4),"same wrapper in two standalone slots cannot be adopted")
	inv.free()
	print("INVENTORY_EDGE_CASES_RESULT assertions=%d failures=%d"%[assertions,failures])
	quit(1 if failures else 0)
